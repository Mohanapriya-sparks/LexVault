# LexVault Environment Configuration Example
# Copy this file to .env for custom local configuration

# Hardhat JSON-RPC Node URL (Default local Hardhat)
HARDHAT_RPC_URL=http://127.0.0.1:8545

# Express Backend Server Port
PORT=3001

# Vite Frontend Server Port
VITE_PORT=3000

# Showcase Mode (Set to true for static web deployment without local backend/Hardhat)
# VITE_SHOWCASE_MODE=true
